[Unit]
Description=Personal WeCom Secretary
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=secretary
Group=secretary
WorkingDirectory=/opt/secretary
ExecStart=/opt/secretary/.venv/bin/python -m secretary --run --env /opt/secretary/.env
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/secretary/data

[Install]
WantedBy=multi-user.target
