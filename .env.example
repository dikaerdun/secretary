# 企业微信：智能机器人 -> API 模式 -> 长连接，复制对应配置。
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# 私人秘书只处理这些企业成员账号的单聊；从通讯录成员详情获取 userid。
WECOM_ALLOWED_USER_IDS=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 按当前官方 API 文档提供默认值；以你的账号可用模型为准。
DEEPSEEK_MODEL=deepseek-flash
SECRETARY_DB_PATH=data/secretary.sqlite3

# 公开单位研究：已有官方 DeepSeek API Key 时自动复用其原生联网搜索，
# 无需另外申请搜索 Key；只在 DEEPSEEK_BASE_URL 指向 api.deepseek.com 时复用。
# 若使用第三方模型代理，或希望使用 Tavily，可选填写下方 Tavily Key。
# 显式填写 Tavily Key 时优先使用 Tavily。联网研究会产生模型/搜索用量。
# 手动研究只需单位全名；后台周期自动研究仍需开启开关并核对官方域名。
PROFILE_WEB_SEARCH_API_KEY=

# 聆记只读录音材料连接；不影响已有企微入口，可暂时留空。
LISTEN_NOTE_API_KEY=
LISTEN_NOTE_MCP_URL=https://collab.ctcdn.cn/mcp
